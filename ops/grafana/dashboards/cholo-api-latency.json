        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(histogram_quantile(0.99, sum by (le, http_route, http_request_method) (rate(http_server_request_duration_bucket{job=\"cholo-api\",http_route=~\"$route\",http_request_method=~\"$method\"}[$window]))), \"http_route\", \"(unmatched)\", \"http_route\", \"\")",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
