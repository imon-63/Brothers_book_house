                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.8
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
