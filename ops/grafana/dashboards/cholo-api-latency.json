        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(cholo_usecase_duration_ms_count{job=\"cholo-api\"}, usecase)",
          "refId": "q"
        },
        "definition": "label_values(cholo_usecase_duration_ms_count{job=\"cholo-api\"}, usecase)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
