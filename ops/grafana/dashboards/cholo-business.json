      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(cholo_order_value_bdt_sum{job=\"cholo-api\"}[$__range])) / clamp_min(sum(increase(cholo_order_value_bdt_count{job=\"cholo-api\"}[$__range])), 1)",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBDT",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
