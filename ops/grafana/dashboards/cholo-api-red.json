{
  "uid": "cholo-api-red",
  "title": "Cholo API · RED",
  "tags": [
    "cholo",
    "api",
    "red"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
