    {
      "id": 5,
      "type": "timeseries",
      "title": "Event-loop delay",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
