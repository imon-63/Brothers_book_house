# ════════════════════════════════════════════════════════════════════════
#  Cholo stack configuration (docker compose reads ./.env automatically)
#    cp .env.example .env   → fill every "change-me"
#  In CI/CD the whole file is written from the PROD_ENV_FILE GitHub secret.
#  Passwords end up inside DATABASE_URL: use URL-safe characters [A-Za-z0-9_-].
# ════════════════════════════════════════════════════════════════════════

# ── images (set by the deploy workflow; latest for manual runs) ──
API_IMAGE=ghcr.io/cholo-shop/cholo-api
WEB_IMAGE=ghcr.io/cholo-shop/cholo-web
IMAGE_TAG=latest
DEPLOY_ENV=production

# ── domain / edge ──
DOMAIN=cholo.shop
# http  = plain HTTP on :80 (local, or behind Cloudflare/another TLS proxy)
# https = TLS on :443 with certs in ops/nginx/certs/live/$DOMAIN/ (see backend/docs/deployment.md)
NGINX_MODE=http
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_WEB_URL=https://cholo.shop
PUBLIC_API_URL=https://cholo.shop
CORS_ORIGINS=https://cholo.shop,https://www.cholo.shop
# baked into the web image at build time (relative → same origin via nginx)
NEXT_PUBLIC_API_URL=/api/v1

# ── database ──
POSTGRES_USER=cholo
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=cholo
DB_POOL_SIZE=10
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_STATEMENT_TIMEOUT=30s
PG_LOG_SLOW_MS=500

# ── auth ──
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# first boot creates this OWNER if none exists; also used by `--profile seed` in production
ADMIN_BOOTSTRAP_EMAIL=admin@cholo.shop
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-admin-password

# ── payments (SSLCOMMERZ) ──
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true

# ── seed (docker compose --profile seed run --rm seed) ──
SEED_NODE_ENV=production
SEED_DEMO_USERS=false
SEED_FORCE=false

# ── API runtime ──
LOG_LEVEL=info
OTEL_ENABLED=true

# ── observability ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_COOKIE_SECURE=true
GRAFANA_LOCAL_PORT=3001
# % of ordinary traces kept (errors, >800ms and checkout/payment traces are always kept)
TRACE_SAMPLE_PCT=25
TEMPO_RETENTION=168h
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=8GB
OTELCOL_VERSION=0.120.0
TEMPO_VERSION=2.7.2
PROMETHEUS_VERSION=v3.2.1
GRAFANA_VERSION=11.5.2
LOKI_VERSION=3.4.2

# ── backups (ops/backup/pg-backup.sh) ──
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7
# s3://bucket/cholo  (leave empty to keep local only)
BACKUP_S3_URI=
# e.g. https://<account>.r2.cloudflarestorage.com  (empty = AWS S3)
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
