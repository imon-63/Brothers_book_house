# ── runtime ──
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ── database ── (DATABASE_URL may point at PgBouncer; DIRECT_URL must be direct)
DATABASE_URL=postgresql://cholo:change-me@localhost:5432/cholo?schema=public
DIRECT_URL=postgresql://cholo:change-me@localhost:5432/cholo?schema=public

# ── auth ──
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ADMIN_BOOTSTRAP_EMAIL=admin@cholo.shop
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong

# ── payments (SSLCOMMERZ) ──
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true

# ── observability ──
OTEL_ENABLED=true
OTEL_SERVICE_NAME=cholo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_PROMETHEUS_PORT=9464
LOG_LEVEL=info
