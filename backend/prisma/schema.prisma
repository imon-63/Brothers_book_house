// ════════════════════════════════════════════════════════════════════════
//  Cholo (চলো) — production database schema
//  PostgreSQL 13+ (16 recommended) · Prisma 6 · NestJS
//
//  Conventions
//  • Tables/columns are snake_case in Postgres, camelCase in Prisma (@map).
//  • Primary keys are UUIDv7 (time-ordered → index friendly) unless the row
//    is reference data (geo) where a small Int is better.
//  • Money is NUMERIC(12,2) in BDT. Never Float.
//  • Every timestamp is timestamptz(3), stored UTC; reports use Asia/Dhaka.
//  • Business numbers shown to humans (CLO-2041, INV-000123) come from
//    `DocumentCounter` inside the same transaction → gapless, race-free.
//  • Snapshots: orders, order items, documents copy the names/prices they
//    were created with. Editing a product never rewrites history.
//  • Ledgers (stock_movements, cash_transactions, financial_documents,
//    audit_logs) are append-only (enforced by triggers in sql/constraints.sql).
//  • Constraints Prisma can't express (CHECKs, partial uniques, exclusion,
//    trigram indexes) live in sql/constraints.sql — applied as a migration.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled (PgBouncer, transaction mode) in prod
  directUrl  = env("DIRECT_URL") // direct, used by `prisma migrate`
  extensions = [citext, pg_trgm, btree_gist]
}

// ════════════════════════════ ENUMS ════════════════════════════

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SUPPORT
  ACCOUNTANT
  WAREHOUSE
  CUSTOMER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum VerificationPurpose {
  PHONE_VERIFY
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_OTP

  @@map("verification_purpose")
}

enum ContentStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("content_status")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  ORDER_RESERVE // order placed/confirmed → stock held
  ORDER_RELEASE // order cancelled before shipping → hold returned
  ORDER_FULFILL // shipped → reserved units leave the shelf
  RETURN_RESTOCK // returned order → back on shelf
  ADJUSTMENT // manual count correction
  DAMAGE
  WRITE_OFF

  @@map("stock_movement_type")
}

enum OrderStatus {
  PENDING // অপেক্ষমাণ
  CONFIRMED // অর্ডার নিশ্চিত
  PROCESSING // প্রস্তুত হচ্ছে
  HANDED_TO_COURIER // কুরিয়ারে তোলা হয়েছে
  OUT_FOR_DELIVERY // ডেলিভারিতে আছে
  DELIVERED // ডেলিভারি সম্পন্ন
  CANCELLED // বাতিল
  RETURNED // ফেরত

  @@map("order_status")
}

enum OrderPriority {
  NORMAL
  HIGH
  URGENT

  @@map("order_priority")
}

enum OrderSource {
  WEB
  ADMIN
  PHONE
  SOCIAL

  @@map("order_source")
}

enum OrderItemKind {
  PRODUCT
  BUNDLE

  @@map("order_item_kind")
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
  BKASH
  NAGAD
  BANK_TRANSFER
  CASH

  @@map("payment_method")
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("order_payment_status")
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED

  @@map("refund_status")
}

enum ShipmentStatus {
  PENDING
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNING
  RETURNED
  CANCELLED

  @@map("shipment_status")
}

enum CodStatus {
  NOT_APPLICABLE
  PENDING
  COLLECTED // courier collected from customer
  REMITTED // courier paid us

  @@map("cod_status")
}

enum DocumentKind {
  INVOICE
  RECEIPT
  CREDIT_NOTE

  @@map("document_kind")
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING

  @@map("coupon_type")
}

enum CouponScope {
  ALL
  SECTION
  CATEGORY
  PRODUCT
  BUNDLE

  @@map("coupon_scope")
}

enum ShippingRuleType {
  MIN_SUBTOTAL // ৳X+ অর্ডারে ফ্রি
  ANY_BUNDLE // প্যাকেজ থাকলে ফ্রি
  SECTION_ONLY // শুধু একটি বিভাগের পণ্য থাকলে ফ্রি (e.g. books)
  CAMPAIGN_ALL // সময় বেঁধে সবার জন্য ফ্রি

  @@map("shipping_rule_type")
}

enum CashAccountType {
  CASH
  MOBILE_WALLET
  BANK
  GATEWAY

  @@map("cash_account_type")
}

enum CashDirection {
  IN
  OUT

  @@map("cash_direction")
}

enum CashTxnKind {
  GATEWAY_SETTLEMENT // SSLCOMMERZ payout
  COD_REMITTANCE // courier paid collected COD
  GATEWAY_FEE
  PURCHASE_PAYMENT
  REFUND
  COURIER_PAYMENT
  COURIER_LOSS
  EXPENSE
  TRANSFER
  OWNER_CAPITAL
  OWNER_DRAW
  MANUAL

  @@map("cash_txn_kind")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED

  @@map("purchase_status")
}

enum SettlementStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("settlement_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED

  @@map("conversation_status")
}

enum MessageSender {
  CUSTOMER
  STAFF
  SYSTEM

  @@map("message_sender")
}

enum TagScope {
  ORDER
  CUSTOMER
  PRODUCT

  @@map("tag_scope")
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  PUSH

  @@map("notification_channel")
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED

  @@map("outbox_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
  OTHER

  @@map("audit_action")
}

enum ActorType {
  STAFF
  CUSTOMER
  SYSTEM
  WEBHOOK

  @@map("actor_type")
}

// ═══════════════════════ IDENTITY & ACCESS ═══════════════════════

/// A login identity. Staff and registered customers both live here;
/// the shopper profile (CRM) is `Customer`, linked 1:1 when registered.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String?    @unique @db.Citext
  phone         String?    @unique @db.VarChar(20) /// E.164, e.g. +8801711111111
  passwordHash  String?    @map("password_hash") /// argon2id; null = OTP-only
  name          String     @db.VarChar(120)
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerified DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLogins  Int        @default(0) @map("failed_logins")
  lockedUntil   DateTime?  @map("locked_until") @db.Timestamptz(3)
  preferences   Json       @default("{}") /// staff UI prefs: lowStockThreshold, pageSize, sidebarRail…
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  customer          Customer?
  sessions          AuthSession[]
  verificationCodes VerificationCode[]

  ordersCreated      Order[]               @relation("OrderCreatedBy")
  statusChanges      OrderStatusHistory[]
  orderNotes         OrderNote[]
  customerNotes      CustomerNote[]
  stockMovements     StockMovement[]
  cashTransactions   CashTransaction[]
  purchases          Purchase[]
  documentsIssued    FinancialDocument[]
  refundsProcessed   Refund[]
  messagesSent       Message[]
  assignedChats      Conversation[]        @relation("ConversationAssignee")
  auditLogs          AuditLog[]
  staffNotifications StaffNotification[]
  reviewsModerated   ProductReview[]       @relation("ReviewModerator")
  priceChanges       ProductPriceHistory[]
  mediaUploaded      MediaAsset[]

  @@index([role, status])
  @@map("users")
}

/// Refresh-token sessions (access tokens are stateless JWT).
model AuthSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") /// sha256 of the token, never the token
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// OTPs and reset codes (store only a hash).
model VerificationCode {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String?             @map("user_id") @db.Uuid
  target     String              @db.VarChar(160) /// phone or email the code was sent to
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("verification_codes")
}

/// Makes POST /orders and payment callbacks safe to retry.
model IdempotencyKey {
  key          String   @id @db.VarChar(80)
  scope        String   @db.VarChar(60) /// e.g. "order.place", "ssl.ipn"
  requestHash  String   @map("request_hash")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ═══════════════════════ GEOGRAPHY (BD) ═══════════════════════
// বিভাগ → জেলা → উপজেলা → ইউনিয়ন. Seeded from the storefront's lib/geo.ts.

model GeoDivision {
  id        Int           @id @default(autoincrement())
  nameBn    String        @unique @map("name_bn") @db.VarChar(60)
  nameEn    String?       @map("name_en") @db.VarChar(60)
  districts GeoDistrict[]

  @@map("geo_divisions")
}

model GeoDistrict {
  id             Int     @id @default(autoincrement())
  divisionId     Int     @map("division_id")
  nameBn         String  @map("name_bn") @db.VarChar(60)
  nameEn         String? @map("name_en") @db.VarChar(60)
  shippingZoneId Int     @map("shipping_zone_id") /// ঢাকা → inside, others → outside

  division     GeoDivision       @relation(fields: [divisionId], references: [id])
  shippingZone ShippingZone      @relation(fields: [shippingZoneId], references: [id])
  upazilas     GeoUpazila[]
  addresses    CustomerAddress[]
  orders       Order[]

  @@unique([divisionId, nameBn])
  @@index([shippingZoneId])
  @@map("geo_districts")
}

model GeoUpazila {
  id         Int     @id @default(autoincrement())
  districtId Int     @map("district_id")
  nameBn     String  @map("name_bn") @db.VarChar(80)
  nameEn     String? @map("name_en") @db.VarChar(80)

  district GeoDistrict @relation(fields: [districtId], references: [id])
  unions   GeoUnion[]

  @@unique([districtId, nameBn])
  @@map("geo_upazilas")
}

model GeoUnion {
  id        Int     @id @default(autoincrement())
  upazilaId Int     @map("upazila_id")
  nameBn    String  @map("name_bn") @db.VarChar(80)
  nameEn    String? @map("name_en") @db.VarChar(80)

  upazila GeoUpazila @relation(fields: [upazilaId], references: [id])

  @@unique([upazilaId, nameBn])
  @@map("geo_unions")
}

// ═══════════════════════ CATALOG ═══════════════════════

/// বিভাগ — storefront section (বই / ঘরের বাজার / গ্যাজেট). Replaces VerticalId.
model Section {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @db.VarChar(30) /// "book" | "food" | "gadget" — stable key used by the app
  nameBn     String   @map("name_bn") @db.VarChar(60)
  nameEn     String   @map("name_en") @db.VarChar(60)
  isVisible  Boolean  @default(true) @map("is_visible") /// storefront switch (hiddenVerticals)
  sortOrder  Int      @default(0) @map("sort_order")
  searchHint String?  @map("search_hint") /// "কোন বই খুঁজছেন?"
  heroKicker String?  @map("hero_kicker")
  heroTitle  String?  @map("hero_title")
  heroSub    String?  @map("hero_sub")
  heroLead   String?  @map("hero_lead")
  content    Json     @default("{}") /// remaining copy blocks (popular, how1, how1p…)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories    Category[]
  products      Product[]
  bundles       Bundle[]
  heroSlides    HeroSlide[]
  shippingRules ShippingRule[]

  @@map("sections")
}

/// ক্যাটাগরি / সাব-ক্যাটাগরি — a 2-level tree per section.
/// Replaces the hard-coded trees + extraCats + hiddenCats.
model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  sectionId   String    @map("section_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  slug        String    @db.VarChar(120)
  nameBn      String    @map("name_bn") @db.VarChar(120)
  nameEn      String?   @map("name_en") @db.VarChar(120)
  description String?
  imageId     String?   @map("image_id") @db.Uuid
  isVisible   Boolean   @default(true) @map("is_visible")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  section  Section     @relation(fields: [sectionId], references: [id])
  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryTree")
  image    MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  products      Product[]      @relation("ProductCategory")
  subProducts   Product[]      @relation("ProductSubcategory")
  heroSlides    HeroSlide[]
  couponTargets CouponTarget[]

  @@unique([sectionId, slug])
  @@index([sectionId, parentId, sortOrder])
  @@map("categories")
}

model Author {
  id        String    @id @default(uuid(7)) @db.Uuid
  slug      String    @unique @db.VarChar(160)
  nameBn    String    @map("name_bn") @db.VarChar(160)
  nameEn    String?   @map("name_en") @db.VarChar(160)
  bio       String?
  photoId   String?   @map("photo_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  photo    MediaAsset?     @relation(fields: [photoId], references: [id], onDelete: SetNull)
  products ProductAuthor[]

  @@map("authors")
}

model Publisher {
  id        String    @id @default(uuid(7)) @db.Uuid
  slug      String    @unique @db.VarChar(160)
  name      String    @db.VarChar(160)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("publishers")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Uuid
  slug      String    @unique @db.VarChar(160)
  name      String    @db.VarChar(160)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// পণ্য. Stock is a cached balance of StockMovement rows (updated in the same tx).
model Product {
  id            String        @id @default(uuid(7)) @db.Uuid
  legacyId      Int?          @unique @map("legacy_id") /// id from the current front-end catalogue
  sku           String        @unique @db.VarChar(60)
  slug          String        @unique @db.VarChar(200)
  sectionId     String        @map("section_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  subcategoryId String?       @map("subcategory_id") @db.Uuid
  publisherId   String?       @map("publisher_id") @db.Uuid
  brandId       String?       @map("brand_id") @db.Uuid
  status        ContentStatus @default(ACTIVE)

  title       String  @db.VarChar(240)
  subtitle    String? @db.VarChar(240) /// author line / unit line shown under the title
  unit        String? @db.VarChar(60) /// "১ লিটার", "৫০০ গ্রাম"
  description String?
  coverColor  String? @map("cover_color") @db.VarChar(9) /// fallback cover (#7A2430)

  // book specifics (nullable for other sections)
  isbn           String? @db.VarChar(20)
  pages          Int?
  edition        String? @db.VarChar(60)
  language       String? @db.VarChar(30)
  // physical / gadget specifics
  weightGrams    Int?    @map("weight_grams")
  warrantyMonths Int?    @map("warranty_months")
  attributes     Json    @default("{}") /// free-form spec sheet

  // pricing
  price          Decimal  @db.Decimal(12, 2) /// নতুন দাম (regular selling price)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2) /// পুরনো দাম
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2) /// কেনা দাম; null → profit unknown
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  freeShipping   Boolean  @default(false) @map("free_shipping")

  // inventory (cached balances; truth = stock_movements)
  trackInventory    Boolean @default(true) @map("track_inventory")
  stockOnHand       Int     @default(0) @map("stock_on_hand") /// physically on the shelf
  stockReserved     Int     @default(0) @map("stock_reserved") /// held by open orders
  initialCopies     Int?    @map("initial_copies") /// আসল কপি
  lowStockThreshold Int?    @map("low_stock_threshold") /// null → store default
  allowBackorder    Boolean @default(false) @map("allow_backorder")

  // denormalised counters (maintained by services / jobs)
  soldCount     Int     @default(0) @map("sold_count")
  ratingAvg     Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int     @default(0) @map("rating_count")
  wishlistCount Int     @default(0) @map("wishlist_count")

  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  version        Int       @default(0) /// optimistic locking for admin edits

  section     Section    @relation(fields: [sectionId], references: [id])
  category    Category   @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory Category?  @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)

  authors         ProductAuthor[]
  images          ProductImage[]
  deals           ProductDeal[]
  priceHistory    ProductPriceHistory[]
  stockMovements  StockMovement[]
  bundleItems     BundleItem[]
  orderItems      OrderItem[]
  orderComponents OrderItemComponent[]
  purchaseItems   PurchaseItem[]
  reviews         ProductReview[]
  wishlist        WishlistItem[]
  cartItems       CartItem[]
  tags            ProductTag[]
  couponTargets   CouponTarget[]

  @@index([sectionId, categoryId, status])
  @@index([subcategoryId])
  @@index([status, soldCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductAuthor {
  productId String @map("product_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid
  role      String @default("author") @db.VarChar(30) /// author | editor | translator
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  Author  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([productId, authorId, role])
  @@index([authorId])
  @@map("product_authors")
}

/// Files in object storage (S3 / R2 / MinIO). Rows point at keys, never blobs.
model MediaAsset {
  id           String   @id @default(uuid(7)) @db.Uuid
  storageKey   String   @unique @map("storage_key")
  url          String
  mimeType     String   @map("mime_type") @db.VarChar(80)
  sizeBytes    Int      @map("size_bytes")
  width        Int?
  height       Int?
  blurhash     String?  @db.VarChar(60)
  alt          String?
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages ProductImage[]
  bundleImages  Bundle[]
  categories    Category[]
  authors       Author[]
  heroSlides    HeroSlide[]
  promoPopups   PromoPopup[]
  reviewImages  ReviewImage[]

  @@map("media_assets")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

/// সময়ের ছাড় — timed price. Non-overlapping per product (exclusion constraint).
model ProductDeal {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  dealPrice   Decimal   @map("deal_price") @db.Decimal(12, 2)
  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  label       String?   @db.VarChar(60)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, endsAt])
  @@map("product_deals")
}

model ProductPriceHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)
  changedById    String?  @map("changed_by_id") @db.Uuid
  reason         String?
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([productId, changedAt(sort: Desc)])
  @@map("product_price_history")
}

/// প্যাকেজ — fixed-price bundle of products.
model Bundle {
  id             String        @id @default(uuid(7)) @db.Uuid
  legacyId       Int?          @unique @map("legacy_id")
  slug           String        @unique @db.VarChar(200)
  sectionId      String        @map("section_id") @db.Uuid
  title          String        @db.VarChar(240)
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2) /// null → Σ item prices
  freeShipping   Boolean       @default(false) @map("free_shipping")
  coverId        String?       @map("cover_id") @db.Uuid
  status         ContentStatus @default(ACTIVE)
  sortOrder      Int           @default(0) @map("sort_order")
  soldCount      Int           @default(0) @map("sold_count")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  section       Section        @relation(fields: [sectionId], references: [id])
  cover         MediaAsset?    @relation(fields: [coverId], references: [id], onDelete: SetNull)
  items         BundleItem[]
  orderItems    OrderItem[]
  wishlist      WishlistItem[]
  cartItems     CartItem[]
  couponTargets CouponTarget[]

  @@index([sectionId, status, sortOrder])
  @@map("bundles")
}

model BundleItem {
  bundleId  String @map("bundle_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

// ═══════════════════════ INVENTORY & PURCHASING ═══════════════════════

/// Append-only stock ledger. products.stock_on_hand = Σ qty_on_hand_delta.
model StockMovement {
  id               String            @id @default(uuid(7)) @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  type             StockMovementType
  qtyOnHandDelta   Int               @map("qty_on_hand_delta")
  qtyReservedDelta Int               @default(0) @map("qty_reserved_delta")
  unitCost         Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  balanceAfter     Int               @map("balance_after") /// on-hand after this move (fast history)
  orderId          String?           @map("order_id") @db.Uuid
  purchaseId       String?           @map("purchase_id") @db.Uuid
  note             String?
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([purchaseId])
  @@map("stock_movements")
}

model Supplier {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(160)
  phone     String?   @db.VarChar(20)
  email     String?   @db.Citext
  address   String?
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  purchases Purchase[]

  @@index([name])
  @@map("suppliers")
}

/// ক্রয় বিল.
model Purchase {
  id            String           @id @default(uuid(7)) @db.Uuid
  purchaseNo    String           @unique @map("purchase_no") @db.VarChar(30) /// PUR-000101
  supplierId    String           @map("supplier_id") @db.Uuid
  status        PurchaseStatus   @default(RECEIVED)
  paymentStatus SettlementStatus @default(UNPAID) @map("payment_status")
  subtotal      Decimal          @db.Decimal(12, 2)
  otherCharges  Decimal          @default(0) @map("other_charges") @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  amountPaid    Decimal          @default(0) @map("amount_paid") @db.Decimal(12, 2)
  invoiceRef    String?          @map("invoice_ref") @db.VarChar(80) /// supplier's challan no.
  note          String?
  purchasedAt   DateTime         @map("purchased_at") @db.Timestamptz(3)
  receivedAt    DateTime?        @map("received_at") @db.Timestamptz(3)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          PurchaseItem[]
  stockMovements StockMovement[]
  payments       CashTransaction[]

  @@index([supplierId, purchasedAt(sort: Desc)])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid(7)) @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  title      String  @db.VarChar(240) /// snapshot
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ═══════════════════════ CUSTOMERS (CRM) ═══════════════════════

/// One row per real shopper, keyed by phone. Guests get a row on first order;
/// registering later links `userId`. Aggregates are maintained by the order service.
model Customer {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  phone          String    @unique @db.VarChar(20) /// E.164 — the CRM identity
  email          String?   @db.Citext
  name           String    @db.VarChar(120)
  isBlocked      Boolean   @default(false) @map("is_blocked")
  blockedReason  String?   @map("blocked_reason")
  blockedAt      DateTime? @map("blocked_at") @db.Timestamptz(3)
  adminNote      String?   @map("admin_note")
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")

  // cached aggregates
  ordersCount     Int       @default(0) @map("orders_count")
  liveOrders      Int       @default(0) @map("live_orders")
  cancelledOrders Int       @default(0) @map("cancelled_orders")
  totalSpent      Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  firstOrderAt    DateTime? @map("first_order_at") @db.Timestamptz(3)
  lastOrderAt     DateTime? @map("last_order_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses         CustomerAddress[]
  orders            Order[]
  notes             CustomerNote[]
  tags              CustomerTag[]
  wishlist          WishlistItem[]
  carts             Cart[]
  reviews           ProductReview[]
  conversations     Conversation[]
  couponRedemptions CouponRedemption[]

  @@index([lastOrderAt(sort: Desc)])
  @@index([totalSpent(sort: Desc)])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id            String    @id @default(uuid(7)) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  label         String?   @db.VarChar(40) /// বাসা / অফিস
  recipientName String    @map("recipient_name") @db.VarChar(120)
  phone         String    @db.VarChar(20)
  districtId    Int       @map("district_id")
  upazila       String?   @db.VarChar(80)
  union         String?   @db.VarChar(80)
  line          String /// গ্রাম / মহল্লা, বাড়ি, রাস্তা
  landmark      String?
  postcode      String?   @db.VarChar(10)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  district GeoDistrict @relation(fields: [districtId], references: [id])

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt(sort: Desc)])
  @@map("customer_notes")
}

/// ভবিষ্যৎ অর্ডার — out-of-stock watchlist. Exactly one of product/bundle (CHECK).
model WishlistItem {
  id              String    @id @default(uuid(7)) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  productId       String?   @map("product_id") @db.Uuid
  bundleId        String?   @map("bundle_id") @db.Uuid
  notifyOnRestock Boolean   @default(true) @map("notify_on_restock")
  notifiedAt      DateTime? @map("notified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle   Bundle?  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@unique([customerId, bundleId])
  @@index([productId])
  @@index([bundleId])
  @@map("wishlist_items")
}

/// Server-side cart (logged-in customers; guests by anonymous token).
model Cart {
  id         String    @id @default(uuid(7)) @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  guestToken String?   @unique @map("guest_token") @db.VarChar(64)
  couponCode String?   @map("coupon_code") @db.Citext
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  bundleId  String?  @map("bundle_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle  Bundle?  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@unique([cartId, bundleId])
  @@map("cart_items")
}

// ═══════════════════════ TAGS ═══════════════════════

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  scope     TagScope
  name      String   @db.VarChar(40) /// উপহার, জরুরি, VIP, পাইকারি …
  color     String?  @db.VarChar(9)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orders    OrderTag[]
  customers CustomerTag[]
  products  ProductTag[]

  @@unique([scope, name])
  @@map("tags")
}

model OrderTag {
  orderId String @map("order_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orderId, tagId])
  @@index([tagId])
  @@map("order_tags")
}

model CustomerTag {
  customerId String @map("customer_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ═══════════════════════ ORDERS ═══════════════════════

model Order {
  id            String             @id @default(uuid(7)) @db.Uuid
  orderNo       String             @unique @map("order_no") @db.VarChar(30) /// CLO-2041
  customerId    String             @map("customer_id") @db.Uuid
  createdById   String?            @map("created_by_id") @db.Uuid /// staff who keyed a phone/admin order
  source        OrderSource        @default(WEB)
  status        OrderStatus        @default(PENDING)
  paymentMethod PaymentMethod      @map("payment_method")
  paymentStatus OrderPaymentStatus @default(UNPAID) @map("payment_status")
  priority      OrderPriority      @default(NORMAL)

  // contact snapshot
  contactName    String  @map("contact_name") @db.VarChar(120)
  contactPhone   String  @map("contact_phone") @db.VarChar(20)
  contactEmail   String? @map("contact_email") @db.Citext
  // shipping address snapshot
  shipDistrictId Int     @map("ship_district_id")
  shipDivision   String  @map("ship_division") @db.VarChar(60)
  shipDistrict   String  @map("ship_district") @db.VarChar(60)
  shipUpazila    String? @map("ship_upazila") @db.VarChar(80)
  shipUnion      String? @map("ship_union") @db.VarChar(80)
  shipLine       String  @map("ship_line")
  shipLandmark   String? @map("ship_landmark")
  shipZoneCode   String  @map("ship_zone_code") @db.VarChar(30) /// snapshot of zone used for pricing

  // money (all BDT)
  currency          String   @default("BDT") @db.Char(3)
  itemsSubtotal     Decimal  @map("items_subtotal") @db.Decimal(12, 2)
  discountTotal     Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
  couponCode        String?  @map("coupon_code") @db.Citext
  shippingFee       Decimal  @default(0) @map("shipping_fee") @db.Decimal(12, 2) /// charged to customer
  shippingFeeReason String?  @map("shipping_fee_reason") /// "৳৫০০+ অর্ডারে ফ্রি" …
  taxTotal          Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal  @map("grand_total") @db.Decimal(12, 2)
  amountPaid        Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountRefunded    Decimal  @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  // cost side (for profit)
  itemsCost         Decimal? @map("items_cost") @db.Decimal(12, 2) /// null → at least one line had unknown cost
  courierCost       Decimal  @default(0) @map("courier_cost") @db.Decimal(12, 2)
  gatewayFee        Decimal  @default(0) @map("gateway_fee") @db.Decimal(12, 2)
  courierLoss       Decimal  @default(0) @map("courier_loss") @db.Decimal(12, 2)

  customerNote  String?      @map("customer_note")
  stockReserved Boolean      @default(false) @map("stock_reserved")
  cancelReason  String?      @map("cancel_reason")
  cancelledFrom OrderStatus? @map("cancelled_from") /// stage at which it was cancelled
  ip            String?      @db.Inet
  userAgent     String?      @map("user_agent")

  placedAt    DateTime  @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(0) /// optimistic lock: UPDATE … WHERE version = $n

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  district  GeoDistrict @relation(fields: [shipDistrictId], references: [id])

  items            OrderItem[]
  history          OrderStatusHistory[]
  notes            OrderNote[]
  tags             OrderTag[]
  shipments        Shipment[]
  payments         Payment[]
  refunds          Refund[]
  documents        FinancialDocument[]
  stockMovements   StockMovement[]
  cashTransactions CashTransaction[]
  couponRedemption CouponRedemption?
  reviews          ProductReview[]

  @@index([status, placedAt(sort: Desc)])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([paymentMethod, paymentStatus])
  @@index([placedAt(sort: Desc)])
  @@index([contactPhone])
  @@map("orders")
}

/// One line on the order. Snapshot of what was sold, at what price and cost.
model OrderItem {
  id               String        @id @default(uuid(7)) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  kind             OrderItemKind
  productId        String?       @map("product_id") @db.Uuid
  bundleId         String?       @map("bundle_id") @db.Uuid
  title            String        @db.VarChar(240)
  sku              String?       @db.VarChar(60)
  sectionCode      String        @map("section_code") @db.VarChar(30) /// বিভাগ for reporting
  categoryName     String?       @map("category_name") @db.VarChar(120)
  quantity         Int
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2) /// price actually charged (deal applied)
  listPrice        Decimal       @map("list_price") @db.Decimal(12, 2) /// regular price at the time
  unitCost         Decimal?      @map("unit_cost") @db.Decimal(12, 2) /// null → cost unknown
  discount         Decimal       @default(0) @db.Decimal(12, 2) /// coupon share allocated to this line
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(12, 2)
  quantityReturned Int           @default(0) @map("quantity_returned")

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  bundle     Bundle?              @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  components OrderItemComponent[]
  reviews    ProductReview[]

  @@index([orderId])
  @@index([productId])
  @@index([bundleId])
  @@map("order_items")
}

/// For BUNDLE lines: which products (and cost) left the shelf.
model OrderItemComponent {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  title            String   @db.VarChar(240)
  quantity         Int
  unitCost         Decimal? @map("unit_cost") @db.Decimal(12, 2)
  allocatedRevenue Decimal  @map("allocated_revenue") @db.Decimal(12, 2) /// bundle price split, for category reports

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([productId])
  @@map("order_item_components")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorType   ActorType    @default(STAFF) @map("actor_type")
  changedById String?      @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderNote {
  id        String    @id @default(uuid(7)) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  body      String
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_notes")
}

// ═══════════════════════ FULFILMENT ═══════════════════════

model Courier {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(30) /// pathao | steadfast | redx | sundarban | ecourier | other
  name        String   @db.VarChar(80)
  trackingUrl String?  @map("tracking_url") /// template: https://…/{tracking}
  isActive    Boolean  @default(true) @map("is_active")
  apiConfig   Json     @default("{}") @map("api_config") /// non-secret config; secrets live in env/secret store
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shipments Shipment[]

  @@map("couriers")
}

model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  courierId      String         @map("courier_id") @db.Uuid
  trackingNo     String?        @map("tracking_no") @db.VarChar(80)
  consignmentId  String?        @map("consignment_id") @db.VarChar(80)
  status         ShipmentStatus @default(PENDING)
  codAmount      Decimal        @default(0) @map("cod_amount") @db.Decimal(12, 2)
  codStatus      CodStatus      @default(NOT_APPLICABLE) @map("cod_status")
  deliveryCharge Decimal        @default(0) @map("delivery_charge") @db.Decimal(12, 2) /// what the courier bills us
  returnCharge   Decimal        @default(0) @map("return_charge") @db.Decimal(12, 2)
  weightGrams    Int?           @map("weight_grams")
  bookedAt       DateTime?      @map("booked_at") @db.Timestamptz(3)
  pickedUpAt     DateTime?      @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  returnedAt     DateTime?      @map("returned_at") @db.Timestamptz(3)
  codCollectedAt DateTime?      @map("cod_collected_at") @db.Timestamptz(3)
  codRemittedAt  DateTime?      @map("cod_remitted_at") @db.Timestamptz(3)
  lastEvent      Json?          @map("last_event") /// raw last webhook from courier
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier @relation(fields: [courierId], references: [id])

  @@unique([courierId, trackingNo])
  @@index([orderId])
  @@index([status])
  @@index([codStatus])
  @@map("shipments")
}

// ═══════════════════════ PAYMENTS ═══════════════════════

/// One attempt with a gateway (SSLCOMMERZ tran_id) or a manual receipt (COD cash).
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  method         PaymentMethod
  provider       String?       @db.VarChar(30) /// sslcommerz | bkash | nagad
  status         PaymentStatus @default(INITIATED)
  amount         Decimal       @db.Decimal(12, 2)
  fee            Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("BDT") @db.Char(3)
  tranId         String?       @unique @map("tran_id") @db.VarChar(80) /// our id sent to the gateway
  valId          String?       @map("val_id") @db.VarChar(80) /// SSLCOMMERZ validation id
  bankTranId     String?       @map("bank_tran_id") @db.VarChar(80)
  cardType       String?       @map("card_type") @db.VarChar(60)
  cardBrand      String?       @map("card_brand") @db.VarChar(30)
  riskLevel      Int?          @map("risk_level")
  failureReason  String?       @map("failure_reason")
  gatewayPayload Json?         @map("gateway_payload") /// validated response (no card data)
  initiatedAt    DateTime      @default(now()) @map("initiated_at") @db.Timestamptz(3)
  succeededAt    DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, initiatedAt])
  @@map("payments")
}

/// Raw IPN / webhook log. (provider, event_key) unique → idempotent handling.
model PaymentEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  paymentId   String?   @map("payment_id") @db.Uuid
  provider    String    @db.VarChar(30)
  eventKey    String    @map("event_key") @db.VarChar(120) /// e.g. val_id or tran_id+status
  eventType   String    @map("event_type") @db.VarChar(60)
  payload     Json
  signatureOk Boolean   @map("signature_ok")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id            String        @id @default(uuid(7)) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  paymentId     String?       @map("payment_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        RefundStatus  @default(REQUESTED)
  reason        String
  providerRef   String?       @map("provider_ref") @db.VarChar(80)
  processedById String?       @map("processed_by_id") @db.Uuid
  processedAt   DateTime?     @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  processedBy User?    @relation(fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

// ═══════════════════════ ACCOUNTING ═══════════════════════

/// Gapless human numbers: SELECT … FOR UPDATE → increment → use, in one tx.
model DocumentCounter {
  scope     String   @id @db.VarChar(30) /// order | invoice | receipt | credit_note | purchase
  prefix    String   @db.VarChar(10) /// CLO- | INV- | RCT- | CRN- | PUR-
  nextValue BigInt   @default(1) @map("next_value")
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("document_counters")
}

/// ইনভয়েস / রিসিট / ক্রেডিট নোট — immutable snapshot documents.
model FinancialDocument {
  id             String       @id @default(uuid(7)) @db.Uuid
  docNo          String       @unique @map("doc_no") @db.VarChar(30)
  kind           DocumentKind
  orderId        String       @map("order_id") @db.Uuid
  issuedById     String?      @map("issued_by_id") @db.Uuid
  // snapshot
  customerName   String       @map("customer_name") @db.VarChar(120)
  customerPhone  String       @map("customer_phone") @db.VarChar(20)
  address        String
  paymentLabel   String       @map("payment_label") @db.VarChar(60)
  lines          Json /// [{kind,id,title,qty,unitPrice,unitCost,lineTotal}]
  subtotal       Decimal      @db.Decimal(12, 2)
  couponCode     String?      @map("coupon_code") @db.Citext
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal      @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  shippingCost   Decimal      @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  gatewayFee     Decimal      @default(0) @map("gateway_fee") @db.Decimal(12, 2)
  taxTotal       Decimal      @default(0) @map("tax_total") @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  // credit notes
  reason         String?
  courierLoss    Decimal?     @map("courier_loss") @db.Decimal(12, 2)
  reverseCourier Boolean      @default(false) @map("reverse_courier")
  creditsDocId   String?      @map("credits_doc_id") @db.Uuid /// the invoice this credit note reverses
  pdfKey         String?      @map("pdf_key") /// rendered PDF in object storage
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issuedBy   User?               @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  credits    FinancialDocument?  @relation("CreditNoteOf", fields: [creditsDocId], references: [id], onDelete: Restrict)
  creditedBy FinancialDocument[] @relation("CreditNoteOf")

  @@index([orderId, kind])
  @@index([kind, issuedAt(sort: Desc)])
  @@map("financial_documents")
}

/// ক্যাশ / বিকাশ / নগদ / ব্যাংক / gateway balance.
model CashAccount {
  id             String          @id @default(uuid(7)) @db.Uuid
  code           String          @unique @db.VarChar(30) /// cash | bkash | nagad | bank | sslcommerz
  name           String          @db.VarChar(80)
  type           CashAccountType
  accountNo      String?         @map("account_no") @db.VarChar(60)
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transactions CashTransaction[]

  @@map("cash_accounts")
}

/// Append-only cashbook. Balance = opening + Σ(IN) − Σ(OUT). Amount always > 0.
model CashTransaction {
  id              String        @id @default(uuid(7)) @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  direction       CashDirection
  kind            CashTxnKind
  amount          Decimal       @db.Decimal(12, 2)
  memo            String /// খতিয়ান
  expenseCategory String?       @map("expense_category") @db.VarChar(60) /// প্যাকিং, বিজ্ঞাপন…
  orderId         String?       @map("order_id") @db.Uuid
  purchaseId      String?       @map("purchase_id") @db.Uuid
  transferGroupId String?       @map("transfer_group_id") @db.Uuid /// pairs IN/OUT of an internal transfer
  reversesId      String?       @unique @map("reverses_id") @db.Uuid /// corrections are reversing entries, never edits
  occurredAt      DateTime      @map("occurred_at") @db.Timestamptz(3)
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  account    CashAccount      @relation(fields: [accountId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchase   Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reverses   CashTransaction? @relation("CashReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy CashTransaction? @relation("CashReversal")

  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@index([kind, occurredAt])
  @@index([orderId])
  @@index([purchaseId])
  @@map("cash_transactions")
}

// ═══════════════════════ PROMOTIONS & SHIPPING ═══════════════════════

model Coupon {
  id               String      @id @default(uuid(7)) @db.Uuid
  code             String      @unique @db.Citext /// CHOLO10 — case-insensitive
  description      String?
  type             CouponType
  value            Decimal     @db.Decimal(12, 2) /// % or ৳ depending on type
  maxDiscount      Decimal?    @map("max_discount") @db.Decimal(12, 2) /// cap for PERCENT
  minSubtotal      Decimal     @default(0) @map("min_subtotal") @db.Decimal(12, 2)
  scope            CouponScope @default(ALL)
  usageLimit       Int?        @map("usage_limit") /// total redemptions
  perCustomerLimit Int?        @map("per_customer_limit")
  usedCount        Int         @default(0) @map("used_count")
  firstOrderOnly   Boolean     @default(false) @map("first_order_only")
  isActive         Boolean     @default(true) @map("is_active")
  showInHeader     Boolean     @default(true) @map("show_in_header") /// nav coupon chips
  startsAt         DateTime?   @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?   @map("ends_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  targets     CouponTarget[]
  redemptions CouponRedemption[]
  promoPopups PromoPopup[]

  @@index([isActive, endsAt])
  @@map("coupons")
}

/// What a scoped coupon applies to (exactly one target column set).
model CouponTarget {
  id          String  @id @default(uuid(7)) @db.Uuid
  couponId    String  @map("coupon_id") @db.Uuid
  sectionCode String? @map("section_code") @db.VarChar(30)
  categoryId  String? @map("category_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  bundleId    String? @map("bundle_id") @db.Uuid

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle   Bundle?   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_targets")
}

model CouponRedemption {
  id         String    @id @default(uuid(7)) @db.Uuid
  couponId   String    @map("coupon_id") @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  discount   Decimal   @db.Decimal(12, 2)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3) /// order cancelled → usage given back
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

/// ঢাকার ভিতর / ঢাকার বাইরে.
model ShippingZone {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(30) /// inside_dhaka | outside_dhaka
  nameBn      String   @map("name_bn") @db.VarChar(60)
  fee         Decimal  @db.Decimal(12, 2) /// charged to customer
  courierCost Decimal  @map("courier_cost") @db.Decimal(12, 2) /// our expected cost
  etaMinDays  Int      @default(1) @map("eta_min_days")
  etaMaxDays  Int      @default(2) @map("eta_max_days")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts GeoDistrict[]

  @@map("shipping_zones")
}

/// Free-delivery rules (freeAbove, freeOnPack, freeOnBooks, freeAll campaign).
model ShippingRule {
  id          String           @id @default(uuid(7)) @db.Uuid
  type        ShippingRuleType
  label       String           @db.VarChar(120)
  minSubtotal Decimal?         @map("min_subtotal") @db.Decimal(12, 2)
  sectionId   String?          @map("section_id") @db.Uuid
  startsAt    DateTime?        @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?        @map("ends_at") @db.Timestamptz(3)
  isActive    Boolean          @default(true) @map("is_active")
  priority    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([isActive, type])
  @@map("shipping_rules")
}

// ═══════════════════════ STOREFRONT CONTENT ═══════════════════════

/// টপবার scrolling lines.
model Announcement {
  id        String    @id @default(uuid(7)) @db.Uuid
  text      String    @db.VarChar(200)
  linkUrl   String?   @map("link_url")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("announcements")
}

/// প্রথম ভিজিটের অফার মডাল.
model PromoPopup {
  id        String    @id @default(uuid(7)) @db.Uuid
  title     String    @db.VarChar(160)
  body      String?
  couponId  String?   @map("coupon_id") @db.Uuid
  imageId   String?   @map("image_id") @db.Uuid
  ctaLabel  String?   @map("cta_label") @db.VarChar(60)
  ctaUrl    String?   @map("cta_url")
  isActive  Boolean   @default(false) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  coupon Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  image  MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@map("promo_popups")
}

model HeroSlide {
  id         String    @id @default(uuid(7)) @db.Uuid
  sectionId  String    @map("section_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  kicker     String?   @db.VarChar(60)
  title      String    @db.VarChar(160)
  subtitle   String?   @db.VarChar(200)
  imageId    String?   @map("image_id") @db.Uuid
  imageUrl   String?   @map("image_url") /// external image (legacy Unsplash URLs)
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  startsAt   DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  section  Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  image    MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([sectionId, isActive, sortOrder])
  @@map("hero_slides")
}

/// Global key/value settings (typed via zod in the API): store name, helpline,
/// gateway_fee_pct, default_low_stock…
model StoreSetting {
  key         String   @id @db.VarChar(80)
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

// ═══════════════════════ REVIEWS ═══════════════════════

model ProductReview {
  id            String       @id @default(uuid(7)) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  customerId    String?      @map("customer_id") @db.Uuid
  orderId       String?      @map("order_id") @db.Uuid
  orderItemId   String?      @map("order_item_id") @db.Uuid /// verified purchase
  displayName   String       @map("display_name") @db.VarChar(120)
  rating        Int /// 1–5 (CHECK)
  title         String?      @db.VarChar(160)
  body          String?
  status        ReviewStatus @default(PENDING)
  helpfulCount  Int          @default(0) @map("helpful_count")
  moderatedById String?      @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?    @map("moderated_at") @db.Timestamptz(3)
  staffReply    String?      @map("staff_reply")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  images      ReviewImage[]

  @@unique([orderItemId, customerId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@map("product_reviews")
}

model ReviewImage {
  reviewId  String @map("review_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reviewId, mediaId])
  @@map("review_images")
}

// ═══════════════════════ SUPPORT CHAT ═══════════════════════

model Conversation {
  id               String             @id @default(uuid(7)) @db.Uuid
  customerId       String?            @map("customer_id") @db.Uuid
  guestToken       String?            @map("guest_token") @db.VarChar(64)
  guestName        String?            @map("guest_name") @db.VarChar(120)
  status           ConversationStatus @default(OPEN)
  assigneeId       String?            @map("assignee_id") @db.Uuid
  channel          String             @default("web") @db.VarChar(20) /// web | whatsapp | messenger
  lastMessageAt    DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(3)
  lastMessageFrom  MessageSender?     @map("last_message_from")
  unreadByStaff    Int                @default(0) @map("unread_by_staff")
  unreadByCustomer Int                @default(0) @map("unread_by_customer")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt         DateTime?          @map("closed_at") @db.Timestamptz(3)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([customerId])
  @@index([guestToken])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  sender         MessageSender
  senderUserId   String?       @map("sender_user_id") @db.Uuid
  body           String
  attachments    Json          @default("[]")
  readAt         DateTime?     @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Saved quick replies for the inbox.
model CannedReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String   @db.VarChar(80)
  body      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("canned_replies")
}

// ═══════════════════════ NOTIFICATIONS ═══════════════════════

/// In-app alerts for staff (bell icon).
model StaffNotification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(60) /// order.pending, stock.low, chat.new…
  title     String
  body      String?
  link      String? /// admin deep link, e.g. #orders/CLO-2041
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("staff_notifications")
}

/// Transactional outbox for SMS / email / WhatsApp (order placed, shipped, OTP…).
/// Written in the same tx as the business change; a worker delivers it.
model NotificationOutbox {
  id            String              @id @default(uuid(7)) @db.Uuid
  channel       NotificationChannel
  recipient     String              @db.VarChar(160)
  template      String              @db.VarChar(80)
  payload       Json
  status        OutboxStatus        @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  providerRef   String?             @map("provider_ref")
  lastError     String?             @map("last_error")
  dedupeKey     String?             @unique @map("dedupe_key") @db.VarChar(120)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// ═══════════════════════ AUDIT ═══════════════════════

/// অ্যাক্টিভিটি লগ — append-only. `before`/`after` hold only changed fields.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  actorName  String?     @map("actor_name") @db.VarChar(120) /// kept even if the user is deleted
  action     AuditAction
  area       String      @db.VarChar(30) /// order | product | finance | settings | customer | chat | auth
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String?     @map("entity_id") @db.VarChar(80)
  summary    String /// human text shown in the admin feed
  before     Json?
  after      Json?
  ip         String?     @db.Inet
  userAgent  String?     @map("user_agent")
  requestId  String?     @map("request_id") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([area, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
